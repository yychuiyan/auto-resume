{
  "manifest_version": 3,
  "name": "简历投递助手",
  "version": "1.0",
  "description": "BOSS / 智联 搜索页抓取后批量投递",
  "permissions": ["storage", "tabs", "scripting", "cookies", "notifications"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["*://*.zhipin.com/*", "*://*.zhaopin.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.zhaopin.com/*"],
      "js": ["zcontent.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "zinject.js"],
      "matches": ["*://*.zhipin.com/*", "*://*.zhaopin.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
